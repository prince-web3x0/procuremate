# ProcureMate configuration. Placeholder names only: never put a real key in this file.
#
# Real mode needs a Brave Search API key. Put it in ONE of these places:
#   1. an environment variable called BRAVE_API_KEY, or
#   2. a file at ~/.procuremate/secrets.env that contains the line below.
#
# With no key, the tools run in demo mode on the saved fixtures in demo/.

BRAVE_API_KEY=your-brave-search-api-key-here

# Optional settings (leave unset to use the defaults):
# DEMO_MODE=1                      # force demo mode, even if a key exists
# PROCUREMATE_SECRETS_FILE=        # use a different secrets file than ~/.procuremate/secrets.env
# PROCUREMATE_AGENT_DIRS=          # agent folders for sync_to_agents.py (';' on Windows, ':' elsewhere)
# PROCUREMATE_DEMO_DIR=            # use a different demo fixtures folder
